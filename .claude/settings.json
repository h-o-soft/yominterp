{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/secretary-idle-flag.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/secretary-bash-guard.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/secretary-active-flag.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(secretary mailbox:*)",
      "Bash(secretary handoff:*)",
      "Bash(secretary handback:*)"
    ]
  }
}
