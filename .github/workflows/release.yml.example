# yominterp デスクトップ版リリース (叩き台 / 署名なし)
#
# 使い方: アイコン確定・動作確認の後、このファイルを `release.yml` にリネームして有効化する。
# `.example` のままなら GitHub は実行しない (確定前にタグ push で署名なしビルドが
# 勝手に走るのを防ぐためのガード)。
#
# トリガ: `v*` タグの push (例: git tag v0.1.0 && git push origin v0.1.0)。
# tauri-action が OS 別にビルドし、GitHub Release (draft) にバイナリを添付する。
#   - macOS: .dmg / .app (Apple Silicon + Intel の 2 アーキ)
#   - Windows: .msi / setup.exe (NSIS)
#   - Linux(任意): .AppImage / .deb
#
# ⚠ 署名・notarization なし: 配布物は未署名。macOS は Gatekeeper、Windows は
#   SmartScreen の警告が出る (回避手順は README/Release ノートで案内する想定)。
#   将来 Apple Developer ID / Windows コード署名証明書を入れる場合は env に
#   署名シークレットを追加する。

name: Release (desktop, unsigned)

on:
  push:
    tags:
      - 'v*'

jobs:
  build:
    permissions:
      contents: write # Release 作成・アセット添付に必要
    strategy:
      fail-fast: false
      matrix:
        include:
          - platform: macos-latest # Apple Silicon
            args: '--target aarch64-apple-darwin'
          - platform: macos-latest # Intel
            args: '--target x86_64-apple-darwin'
          - platform: windows-latest
            args: ''
          # Linux も配布する場合はコメントを外す
          # - platform: ubuntu-22.04
          #   args: ''
    runs-on: ${{ matrix.platform }}
    steps:
      - uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Setup Rust
        uses: dtolnay/rust-toolchain@stable
        with:
          targets: ${{ contains(matrix.platform, 'macos') && 'aarch64-apple-darwin,x86_64-apple-darwin' || '' }}

      - name: Install Linux deps
        if: matrix.platform == 'ubuntu-22.04'
        run: |
          sudo apt-get update
          sudo apt-get install -y libwebkit2gtk-4.1-dev libappindicator3-dev librsvg2-dev patchelf

      - name: Install npm deps
        run: npm ci

      - name: Build & release (tauri-action)
        uses: tauri-apps/tauri-action@v0
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        with:
          # beforeBuildCommand (npm run build:web) は tauri.conf.json に定義済み
          tagName: ${{ github.ref_name }}
          releaseName: 'yominterp ${{ github.ref_name }}'
          releaseBody: '署名なしの開発ビルドです。macOS/Windows で警告が出る場合の対処は README を参照してください。'
          releaseDraft: true
          prerelease: false
          args: ${{ matrix.args }}
