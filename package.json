{
  "name": "zmachine-llm",
  "version": "0.1.0",
  "private": true,
  "description": "Z-machine IF を LLM 翻訳層経由で日本語プレイ可能にする CLI 試作 (段階1)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "play": "tsx src/cli/main.ts",
    "verify": "tsx src/verify/run-transcript.ts",
    "gen-ja": "tsx src/verify/gen-ja-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval:paraphrase": "tsx src/verify/paraphrase-eval.ts",
    "proxy": "tsx scripts/zllm-proxy.mts",
    "build:web": "vite build",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.5",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "emglken": "^0.7.2",
    "idb-keyval": "^6.2.5"
  }
}
